---
import FieldLabel from "./FieldLabel.astro";
import Tag from "./Tag.astro";
import { formatRange, isoDate, yearsBetween } from "../lib/date";

/**
 * One dated row of the record, ruled into columns: the span of time, the
 * substance, and a marginal note keyed to it. The present appointment is the
 * thing under examination and is the only row the reserved ink touches.
 */
interface Props {
  ref?: string;
  role: string;
  organisation: string;
  location?: string;
  start: Date;
  end?: Date | null;
  summary: string;
  highlights?: string[];
  tags?: string[];
  note?: string;
}

const {
  ref,
  role,
  organisation,
  location,
  start,
  end,
  summary,
  highlights = [],
  tags = [],
  note,
} = Astro.props;

const current = !end;
---

<article
  class="grid grid-cols-1 gap-x-8 gap-y-3 border-t border-rule py-6 md:grid-cols-[8.5rem_1fr] lg:grid-cols-[8.5rem_1fr_15rem]"
>
  {/* Column one: the span of time, and the reference code. */}
  <div class="flex items-baseline gap-3 md:flex-col md:gap-1">
    {ref && (
      <FieldLabel class:list={[current && "text-carmine"]}>{ref}</FieldLabel>
    )}
    <div class="flex items-center gap-2">
      {
        current && (
          <span
            class="under-examination size-[0.4rem] shrink-0"
            aria-hidden="true"
          />
        )
      }
      <time
        class="font-code text-[0.7rem] tracking-[0.06em] whitespace-nowrap text-ink-muted tabular"
        datetime={isoDate(start)}
      >
        {formatRange(start, end)}
      </time>
    </div>
    <FieldLabel class="normal-case">
      {yearsBetween(start, end)} yr{yearsBetween(start, end) === 1 ? "" : "s"}
    </FieldLabel>
  </div>

  {/* Column two: the substance. */}
  <div>
    <h3 class="font-record text-[1.3rem] leading-tight">
      {role}
      <span class="text-ink-muted"> · </span>
      <span class="text-ink">{organisation}</span>
    </h3>

    {location && (
      <p class="mt-1 font-code text-[0.7rem] tracking-[0.08em] text-ink-subtle uppercase">
        {location}
      </p>
    )}

    <p class="mt-3 max-w-[68ch] text-[1rem] leading-relaxed text-ink-muted">
      {summary}
    </p>

    {
      highlights.length > 0 && (
        <ul class="mt-3 space-y-1.5 max-w-[68ch]">
          {highlights.map((h) => (
            <li class="flex gap-3 text-[1rem] leading-relaxed text-ink-muted">
              <span class="mt-[0.7em] size-px shrink-0 bg-rule-strong" />
              <span>{h}</span>
            </li>
          ))}
        </ul>
      )
    }

    {tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <li>
            <Tag>{t}</Tag>
          </li>
        ))}
      </ul>
    )}
  </div>

  {/* The margin. Only rendered when the entry earns one — on a wide screen it
      sits in its own column, the way a note sits beside a passage. */}
  {
    note && (
      <aside class="border-t border-dotted border-rule pt-3 md:col-start-2 md:mt-1 md:max-w-[36ch] md:border-t-0 md:border-l md:pt-0 md:pl-5 lg:col-start-3 lg:mt-0 lg:pt-0.5">
        <FieldLabel>Note</FieldLabel>
        <p class="mt-1.5 text-[1rem] leading-relaxed text-ink-muted italic">
          {note}
        </p>
      </aside>
    )
  }
</article>
