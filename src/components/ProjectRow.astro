---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import Tag from "./Tag.astro";
import { withBase } from "../lib/paths";

/**
 * Projects as a ledger of numbered entries, not a row of equal cards. A card
 * grid would flatten four different pieces of work into one shape and hide the
 * only thing that matters here, which is that they differ.
 */
interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, year, tags, links } = project.data;
const ref = `FIG-${String(index + 1).padStart(2, "0")}`;

const linkItems = Object.entries(links).filter(
  (entry): entry is [string, string] => Boolean(entry[1]),
);
---

<article
  class="group grid grid-cols-1 gap-x-8 gap-y-2 border-t border-rule py-6 md:grid-cols-[5rem_1fr_4rem]"
>
  <div class="flex items-baseline gap-3 md:block">
    <span
      class="font-code text-[0.62rem] tracking-[0.16em] text-ink-subtle uppercase tabular"
    >
      {ref}
    </span>
    {year && (
      <span class="font-code text-[0.62rem] tracking-[0.1em] text-ink-subtle tabular md:mt-1 md:block">
        {year}
      </span>
    )}
  </div>

  <div>
    <h3 class="font-record text-[1.3rem] leading-tight">
      <a
        href={withBase(`/projects/${project.id}/`)}
        class="underline decoration-rule-strong decoration-1 underline-offset-[0.22em] transition-colors hover:decoration-ink"
      >
        {title}
      </a>
    </h3>

    <p class="mt-2 max-w-[68ch] text-[0.95rem] leading-relaxed text-ink-muted">
      {summary}
    </p>

    {
      linkItems.length > 0 && (
        <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1">
          {linkItems.map(([kind, href]) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-code text-[0.62rem] tracking-[0.14em] text-ink uppercase underline decoration-rule underline-offset-[0.22em] transition-colors hover:decoration-ink"
              >
                {kind}
                <Icon name="arrow-up-right" size={11} />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <li>
            <Tag>{t}</Tag>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="md:text-right">
    <a
      href={withBase(`/projects/${project.id}/`)}
      aria-label={`Read ${title}`}
      class="inline-flex items-center gap-1 font-code text-[0.62rem] tracking-[0.14em] text-ink-subtle uppercase transition-colors group-hover:text-ink"
    >
      Read
      <Icon name="arrow-right" size={12} />
    </a>
  </div>
</article>
