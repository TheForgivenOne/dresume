---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { site } from "../data/site";
import { withBase } from "../lib/paths";
import "../styles/global.css";
import "../styles/depth.css";

/**
 * The screen record. One continuous sheet in a viewing volume: the ground
 * falls away, the paper is the plane, the content sits proud of it, and the
 * seal stands highest of all.
 */
interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const {
  title = `${site.name} — ${site.title}`,
  description = site.tagline,
  ogType = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase("/og.png"), Astro.site).href;
---

<!doctype html>
<html lang="en" style={`--exam-ink: ${site.examinationInk}`}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase("/rss.xml")} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons. Order matters: the browser takes the last format it supports,
         so the scalable SVG leads and the raster fallbacks follow. -->
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("/favicon-16.png")} />
    <link rel="shortcut icon" href={withBase("/favicon.ico")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
    <link rel="mask-icon" href={withBase("/mask-icon.svg")} color="#9d2135" />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <meta name="generator" content={Astro.generator} />

    <ThemeScript />

    {/* Marks the document as arriving, before first paint, so the sequence has
        no flash of already-settled content. Deliberately set unconditionally
        and left in place: the CSS that reads it is gated behind
        prefers-reduced-motion, so a reader who asked for stillness never sees it
        do anything, and removing it would risk a second run on back-navigation. */}
    <script is:inline>
      document.documentElement.dataset.settling = "true";
    </script>
  </head>

  <body>
    <a
      href="#record"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-ink focus:bg-paper-raised focus:px-3 focus:py-2"
    >
      Skip to the record
    </a>

    <div class="record-stage relative py-0 md:py-12">
      <!-- The desk the record is lying on. -->
      <div
        class="record-ground layer-ground pointer-events-none fixed inset-0 -z-10"
        aria-hidden="true"
      >
      </div>

      <div class="record-sheet">
        <Header />

        <!-- The header stays outside this element so it remains ordinary 2D
             sticky; see the .record-sheet note in depth.css. -->
        <div class="depth-stage">
          <main class="px-6 pt-10 md:px-14 md:pt-14">
            <slot />
          </main>

          <div class="px-6 md:px-14">
            <Footer />
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  /**
   * The whole record tilts as one physical object. Nothing on it wobbles
   * independently — a printed sheet does not flutter, and a resume that
   * animates each card is a resume nobody can read.
   *
   * The tilt attaches only once the sheet has landed. Two reasons: the arrival
   * animates the sheet's own transform, and fighting it would read as a wobble;
   * and a record that has not finished arriving should not respond to a pointer
   * yet. The sequence is 1.35s and then the sheet is a physical object you can
   * pick up.
   */
  const sheet = document.querySelector<HTMLElement>(".record-sheet");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  const attachTilt = () => {
    if (!sheet) return;
    const MAX = 2.4; // degrees. Past ~4 it reads as a toy.
    let frame = 0;

    const apply = (rx: number, ry: number) => {
      sheet.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
    };

    addEventListener(
      "pointermove",
      (e) => {
        const px = e.clientX / innerWidth - 0.5;
        const py = e.clientY / innerHeight - 0.5;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => apply(-py * MAX, px * MAX));
      },
      { passive: true },
    );

    // Settle flat when the pointer leaves, or the record stays canted.
    document.addEventListener("pointerleave", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => apply(0, 0));
    });
  };

  if (sheet && fine.matches && !calm.matches) {
    // Longest delay in the sequence is 620ms + 700ms of duration.
    const LANDED = 1400;
    let attached = false;
    const once = () => {
      if (attached) return;
      attached = true;
      attachTilt();
    };
    sheet.addEventListener("animationend", once, { once: true });
    // Belt and braces: if the animation never fires — a browser that drops it, a
    // tab restored from cache mid-flight — the tilt must not be lost with it.
    setTimeout(once, LANDED);
  }

  // The ruled baselines draw in once. A transform only — nothing starts
  // hidden, so a capture can never read an undrawn rule as a missing element.
  const baselines = document.querySelectorAll<HTMLElement>(".ruled-baseline");
  if (baselines.length && !calm.matches) {
    requestAnimationFrame(() => {
      baselines.forEach((el, i) => {
        el.style.animationDelay = `${420 + i * 90}ms`;
        el.dataset.draw = "true";
      });
    });
  }

  /**
   * The rest of the record reveals as it is reached, not on load. A reader who
   * never scrolls should not pay for work they never see, and the sections are
   * the argument, not the effect — they arrive as you arrive.
   *
   * The 2.5s failsafe is the important part. Anything hidden by `data-reveal`
   * is invisible, and a content section that never fires its observer is a
   * section a reader cannot read. The observer is an enhancement; the timeout
   * guarantees the page is complete even if it is never called.
   */
  const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const revealAll = () => revealTargets.forEach((el) => (el.dataset.revealed = "true"));

  if (revealTargets.length && !calm.matches) {
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            (entry.target as HTMLElement).dataset.revealed = "true";
            io.unobserve(entry.target);
          }
        },
        // Fires as the section's top edge reaches the lower third, so the rise
        // has usually finished by the time it is comfortably in view.
        { rootMargin: "0px 0px -18% 0px" },
      );
      revealTargets.forEach((el) => io.observe(el));
    }
    setTimeout(revealAll, 2500);
  }
</script>
