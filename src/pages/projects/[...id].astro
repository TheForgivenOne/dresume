---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, year, tags, links } = project.data;
const { Content } = await render(project);

const index = (await getCollection("projects", ({ data }) => !data.draft)).findIndex(
  (p) => p.id === project.id,
);
const ref = `FIG-${String(index + 1).padStart(2, "0")}`;
const linkItems = Object.entries(links).filter(
  (entry): entry is [string, string] => Boolean(entry[1]),
);
---

<BaseLayout title={`${title} — ${project.id}`} description={summary}>
  <article>
    <!-- A typographic plate. No photograph exists for this project and none
         may be invented, so the cover is set rather than shot.

         The rule above is a real border on this element. It must not be the
         .ruled-baseline utility, which is height:0 and collapses any content
         placed on it straight over whatever follows. -->
    <header class="border-t border-rule-strong pt-8">
      <div class="flex items-start gap-8">
        <span
          class="font-code text-[0.7rem] tracking-[0.18em] text-ink-subtle uppercase tabular"
        >
          {ref}
        </span>

        <div>
          <h1 class="font-record text-[clamp(2.4rem,7vw,4rem)] leading-[0.98]">
            {title}
          </h1>
          <p class="mt-5 max-w-[62ch] text-[1.05rem] leading-relaxed text-ink-muted">
            {summary}
          </p>

          <div
            class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-rule pt-4"
          >
            {year && (
              <span class="font-code text-[0.7rem] tracking-[0.1em] text-ink-subtle uppercase tabular">
                {year}
              </span>
            )}
            {
              linkItems.map(([kind, href]) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-code text-[0.7rem] tracking-[0.14em] text-ink uppercase underline decoration-rule underline-offset-[0.24em] transition-colors hover:decoration-ink"
                >
                  {kind}
                  <Icon name="arrow-up-right" size={12} />
                </a>
              ))
            }
          </div>

          {tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <li>
                  <Tag>{t}</Tag>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </header>

    <div class="mt-12 ruled-baseline" role="presentation"></div>

    <div class="prose-record mt-10 max-w-[68ch]">
      <Content />
    </div>

    <nav class="mt-16 border-t border-rule-strong pt-6">
      <a
        href={withBase("/#projects")}
        class="inline-flex items-center gap-2 font-code text-[0.7rem] tracking-[0.14em] text-ink-muted uppercase transition-colors hover:text-ink"
      >
        <Icon name="arrow-right" size={13} class="rotate-180" />
        All projects
      </a>
    </nav>
  </article>
</BaseLayout>
